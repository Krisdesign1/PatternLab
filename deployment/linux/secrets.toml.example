# Create /opt/patternlab/.streamlit/secrets.toml on the Linux host yourself.
# Owner: patternlab:patternlab; mode: 0600. Do not upload the Mac secrets file.
PATTERNLAB_STORAGE_MODE = "local"
API_FOOTBALL_KEY = ""

[access]
# Required behind a reverse proxy, even though Streamlit binds to loopback.
local_owner = false
shared_writes = false # Preserve the qualified worker as the sole shared-data writer.
admin_emails = []

# Optional OIDC: register https://YOUR_REAL_DOMAIN/oauth2callback with the
# identity provider before adding the following [auth] values and an explicit
# admin allowlist above. Leave this section commented until it is configured.
# [auth]
# redirect_uri = "https://YOUR_REAL_DOMAIN/oauth2callback"
# cookie_secret = "GENERATE_A_NEW_RANDOM_SECRET_ON_THE_SERVER"
# client_id = ""
# client_secret = ""
# server_metadata_url = ""
