[Unit]
Description=PatternLab Caddy HTTPS reverse proxy
Wants=network-online.target
After=network-online.target patternlab-web.service
Requires=patternlab-web.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
User=caddy
Group=caddy
Environment=XDG_DATA_HOME=/var/lib/patternlab-caddy
Environment=XDG_CONFIG_HOME=/var/lib/patternlab-caddy/config
StateDirectory=patternlab-caddy
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/caddy run --config /etc/patternlab/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/patternlab/Caddyfile --adapter caddyfile --force
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
